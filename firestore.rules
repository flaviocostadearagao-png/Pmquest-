rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User study profiles & statistics
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User question responses history
      match /questoes_respondidas/{questaoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User topic study status
      match /topicos_estudados/{topicoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
